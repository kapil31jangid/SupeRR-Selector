# .streamlit/secrets.toml
# PRESSURE-X | Backboard AI Integration Credentials
#
# IMPORTANT: This file is listed in .gitignore and must NEVER be committed to version control.
# Never share this file, paste its contents in chat, or hardcode values in source code.
#
# HOW TO ADD YOUR API KEY:
# 1. Get your Backboard API key from: https://app.backboard.io/dashboard/api-keys
# 2. Replace the placeholder below with your actual key.
# 3. Save this file. Restart `streamlit run app.py`.
#
# Alternatively, set the environment variable:
#     export BACKBOARD_API_KEY="your_key_here"      (Unix/macOS)
#     $env:BACKBOARD_API_KEY = "your_key_here"      (Windows PowerShell)

BACKBOARD_API_KEY = "your_backboard_api_key_here"

# Optional overrides (defaults shown — do not change unless needed):
# BACKBOARD_BASE_URL = "https://app.backboard.io/api"
# BACKBOARD_PROVIDER = "google"
# BACKBOARD_MODEL_NAME = "gemini-2.5-pro"

